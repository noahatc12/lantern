{
  "name": "lantern",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit",
    "lint:decks": "node scripts/lint-decks.mjs",
    "shots": "node scripts/shots.mjs",
    "check": "npm run typecheck && npm run test && npm run lint:decks",
    "test": "vitest run",
    "seal": "node scripts/seal.mjs",
    "walk": "node scripts/walkthrough.mjs",
    "audit": "node scripts/walkthrough.mjs",
    "publish": "node scripts/publish.mjs",
    "monkey": "node scripts/monkey.mjs",
    "scenarios": "node scripts/scenarios.mjs",
    "soak": "node scripts/soak.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.49.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.9"
  }
}
